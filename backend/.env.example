PORT=4000
JWT_SECRET=unipolicy-dev-secret-change-me
USE_IN_MEMORY_STORE=true
ANTHROPIC_API_KEY=
UPLOAD_DIR=./uploads
DATA_FILE=./data/store.json

# Cloudinary — use the exact Cloud name from:
# https://console.cloudinary.com → Settings → Product environment credentials
# (NOT the product display name like "Vision-y")
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# After setting credentials, upload all photos into structured folders:
#   npm run sync:media --prefix backend
# Folders created:
#   vision-y/branding   vision-y/students   vision-y/faculty
#   vision-y/staff      vision-y/users/{role}